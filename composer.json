{
  "name": "coisa/sandbox",
  "description": "A local PHP experimentation sandbox built on released PHP FastForward components.",
  "type": "project",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Felipe Sayão Lobato Abreu",
      "email": "github@mentordosnerds.com"
    }
  ],
  "support": {
    "source": "https://github.com/coisa/php-sandbox",
    "issues": "https://github.com/coisa/php-sandbox/issues"
  },
  "require": {
    "php": "^8.3",
    "ext-mbstring": "*",
    "fast-forward/framework": "^1.4",
    "psr/clock": "^1.0",
    "psr/container": "^2.0",
    "psr/event-dispatcher": "^1.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false,
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "lint": "@php bin/lint.php",
    "check": [
      "@composer validate --strict",
      "@lint",
      "@test"
    ],
    "example": "@php bin/app",
    "example:http": "@php examples/http.php",
    "example:client": "@php examples/http-client.php",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S 127.0.0.1:8080 -t public public/index.php"
    ]
  }
}
